# Copy to .env for local development. Never commit real secrets.
# Production values live in AWS Secrets Manager, retrieved by the EC2 instance role.

APP_ENV=local
APP_NAME=Retail Lense

# Frontend (Streamlit) -> Backend (FastAPI)
FRONTEND_PORT=8501
BACKEND_URL=http://localhost:8000
BACKEND_PORT=8000
# Empty = Streamlit calls FastAPI auth routes (local).
# AWS EC2: omit AUTH_API_URL / REDIS_URL / REDIS_PASSWORD / SESSION_COOKIE_PASSWORD.
# Streamlit reads Secrets Manager secrets named retaillen/<ENV_VAR>
# (retaillen/AUTH_API_URL, retaillen/REDIS_URL, retaillen/REDIS_PASSWORD,
# retaillen/SESSION_COOKIE_PASSWORD). Local: set the four values below.
# AUTH_API_URL=https://xxxx.lambda-url.us-east-1.on.aws

# Shared Streamlit sessions. Both frontends use the same Redis.
# Local: set REDIS_URL / REDIS_PASSWORD here. EC2: put them in
# retaillen/REDIS_URL and retaillen/REDIS_PASSWORD.
# REDIS_URL=redis://:replace-with-password@10.0.1.10:6379/0
REDIS_PASSWORD=
# Same long random value on both Streamlit instances; never commit it.
SESSION_COOKIE_PASSWORD=

# AWS — backend + worker use the EC2 instance role. Frontend EC2 may attach
# only retaillen-frontend-runtime (GetSecretValue on retaillen/AUTH_API_URL,
# retaillen/REDIS_URL, retaillen/REDIS_PASSWORD, retaillen/SESSION_COOKIE_PASSWORD).
# Do not put AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_PROFILE on frontend.
AWS_REGION=us-east-1
# Local: named profile in ~/.aws (Compose mounts it into backend and worker).
# AWS_PROFILE=retaillen-dev-runtime
# Backend EC2: omit AWS_PROFILE entirely. Do not set AWS_PROFILE= (empty string).
# boto3 treats a blank profile name as missing. A laptop profile that is not in
# the container also falls through to instance role retaillen-backend-runtime.
AWS_ACCOUNT_ID=

S3_BUCKET=retaillen-dev
S3_PREFIX_PUBLIC=public/
S3_PREFIX_UPLOADS=uploads/
S3_PREFIX_RESULTS=results/
# Object already uploaded to the bucket (default: public/transactions_sample.csv)
S3_TRANSACTIONS_SAMPLE_KEY=public/transactions_sample.csv

DDB_USERS_TABLE=retaillen-users
DDB_OTPS_TABLE=retaillen-otps
DDB_ANALYSES_TABLE=retaillen-analyses
# Empty = in-memory users when APP_ENV=local. Local DynamoDB:
#   docker compose up -d dynamodb
#   DDB_ENDPOINT=http://127.0.0.1:8001
#   ./infra/scripts/create_dynamodb_tables.sh --yes
# Real AWS: APP_ENV=aws and leave DDB_ENDPOINT empty.
DDB_ENDPOINT=

SQS_ANALYSIS_QUEUE_URL=
SNS_OTP_TOPIC_ARN=
SNS_ANALYSIS_COMPLETE_TOPIC_ARN=
# Optional SMS 2FA (Account page). false = codes go to the API log.
SNS_SMS_ENABLED=false
OTP_TTL_SECONDS=300
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5

# Secrets Manager secret names (not the secret values)
JWT_SECRET_NAME=retaillen/jwt
OPENAI_SECRET_NAME=retaillen/openai

# Local-only fallbacks for docker-compose. Leave empty in AWS.
JWT_SECRET=
OPENAI_API_KEY=
CAPTCHA_SECRET=

# Auth (lockout after failed logins; no user groups)
ALLOW_SIGNUP=true
TOKEN_TIME=48
REMEMBER_ME_DAYS=14
SECURITY_MAX_LOGIN_ATTEMPTS=5
SECURITY_USER_LOCKOUT_TIME=24
SECURITY_MAX_FAILED_PER_IP=20
SECURITY_IP_WINDOW_MINUTES=15
DDB_LOGIN_HISTORY_TABLE=retaillen-login-history
DDB_PASSWORD_RESET_TABLE=retaillen-password-reset

# Email. Empty SMTP_HOST = in-memory outbox (tests), no message is sent.
# External SMTP (Gmail, STARTTLS). On EC2 leave SMTP_USER and SMTP_PASSWORD
# empty; the backend reads retaillen/SMTP_USER and retaillen/SMTP_PASSWORD.
# Set BASE_URL to the site users open (https://www.retaillen.cloud on EC2).
BASE_URL=http://localhost:8501
# Streamlit URL for pages/3_Reset_Password.py — not a FastAPI route
PASSWORD_RESET_PATH=/Reset_Password
PASSWORD_RESET_TOKEN_HOURS=48
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM_NAME=Retail Lense
SMTP_FROM_EMAIL=
SMTP_USER=
SMTP_PASSWORD=
SMTP_AUTH_STRATEGY=TLS
