[Unit]
Description=Retail Lense Streamlit
After=network.target retaillen-api.service

[Service]
Type=simple
User=mike
Group=mike
WorkingDirectory=/home/mike/retail-lense/frontend
EnvironmentFile=-/home/mike/retail-lense/.env
Environment=BACKEND_URL=http://127.0.0.1:8000
ExecStart=/home/mike/retail-lense/frontend/.venv/bin/streamlit run app.py --server.address=0.0.0.0 --server.port=8501 --server.headless=true
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
