{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "S3ReadPublicUploadsResults",
            "Effect": "Allow",
            "Action": "s3:GetObject",
            "Resource": [
                "arn:aws:s3:::retaillen-dev/public/*",
                "arn:aws:s3:::retaillen-dev/uploads/*",
                "arn:aws:s3:::retaillen-dev/results/*"
            ]
        },
        {
            "Sid": "S3PutUploadsAndResults",
            "Effect": "Allow",
            "Action": [
                "s3:PutObject",
                "s3:DeleteObject"
            ],
            "Resource": [
                "arn:aws:s3:::retaillen-dev/uploads/*",
                "arn:aws:s3:::retaillen-dev/results/*"
            ]
        },
        {
            "Sid": "DynamoDbAppTables",
            "Effect": "Allow",
            "Action": [
                "dynamodb:DescribeTable",
                "dynamodb:GetItem",
                "dynamodb:PutItem",
                "dynamodb:UpdateItem",
                "dynamodb:DeleteItem",
                "dynamodb:Query",
                "dynamodb:Scan"
            ],
            "Resource": [
                "arn:aws:dynamodb:us-east-1:817817875692:table/retaillen-users",
                "arn:aws:dynamodb:us-east-1:817817875692:table/retaillen-users/index/*",
                "arn:aws:dynamodb:us-east-1:817817875692:table/retaillen-login-history",
                "arn:aws:dynamodb:us-east-1:817817875692:table/retaillen-login-history/index/*",
                "arn:aws:dynamodb:us-east-1:817817875692:table/retaillen-password-reset",
                "arn:aws:dynamodb:us-east-1:817817875692:table/retaillen-otps",
                "arn:aws:dynamodb:us-east-1:817817875692:table/retaillen-analyses",
                "arn:aws:dynamodb:us-east-1:817817875692:table/retaillen-analyses/index/*"
            ]
        },
        {
            "Sid": "SqsAnalysisQueue",
            "Effect": "Allow",
            "Action": [
                "sqs:ReceiveMessage",
                "sqs:DeleteMessage",
                "sqs:SendMessage",
                "sqs:GetQueueAttributes",
                "sqs:ChangeMessageVisibility"
            ],
            "Resource": "arn:aws:sqs:us-east-1:817817875692:retaillen-analysis-queue"
        },
        {
            "Sid": "SnsSmsOtp",
            "Effect": "Allow",
            "Action": "sns:Publish",
            "Resource": "*"
        },
        {
            "Sid": "SnsAnalysisComplete",
            "Effect": "Allow",
            "Action": [
                "sns:Publish",
                "sns:Subscribe",
                "sns:Unsubscribe",
                "sns:SetSubscriptionAttributes"
            ],
            "Resource": [
                "arn:aws:sns:us-east-1:817817875692:retaillen-analysis-complete",
                "arn:aws:sns:us-east-1:817817875692:retaillen-analysis-complete:*"
            ]
        },
        {
            "Sid": "ReadRuntimeSecrets",
            "Effect": "Allow",
            "Action": "secretsmanager:GetSecretValue",
            "Resource": [
	 	 "arn:aws:secretsmanager:us-east-1:817817875692:secret:retaillen/jwt-*",
       		 "arn:aws:secretsmanager:us-east-1:817817875692:secret:retaillen/openai-*",
        	"arn:aws:secretsmanager:us-east-1:817817875692:secret:retaillen/REDIS_URL-*",
        	"arn:aws:secretsmanager:us-east-1:817817875692:secret:retaillen/REDIS_PASSWORD-*",
		 "arn:aws:secretsmanager:us-east-1:817817875692:secret:retaillen/SMTP_USER-*",
                "arn:aws:secretsmanager:us-east-1:817817875692:secret:retaillen/SMTP_PASSWORD-*" 
            ]
        }
    ]
}
