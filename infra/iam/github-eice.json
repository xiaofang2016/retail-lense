{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DescribeInstancesForEiceSsh",
      "Effect": "Allow",
      "Action": "ec2:DescribeInstances",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "DescribeEiceEndpoint",
      "Effect": "Allow",
      "Action": "ec2:DescribeInstanceConnectEndpoints",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "SendSshPublicKey",
      "Effect": "Allow",
      "Action": "ec2-instance-connect:SendSSHPublicKey",
      "Resource": "arn:aws:ec2:us-east-1:817817875692:instance/*",
      "Condition": {
        "StringEquals": {
          "ec2:osuser": "mike"
        }
      }
    },
    {
      "Sid": "OpenEiceTunnel",
      "Effect": "Allow",
      "Action": "ec2-instance-connect:OpenTunnel",
      "Resource": "arn:aws:ec2:us-east-1:817817875692:instance-connect-endpoint/*"
    }
  ]
}
